@using BugTrackerMVC.Enums
@using Microsoft.AspNetCore.Identity
@inject SignInManager<BTUser> SignInManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var signedIn = SignInManager.IsSignedIn(User);

    string Nav(string targetController, params string[] actions)
    {
        if (!string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        if (actions.Length == 0 || actions.Any(a => string.Equals(action, a, StringComparison.OrdinalIgnoreCase)))
        {
            return "is-active";
        }

        return "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheBugTracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-F3w7mX95PdgyTmZZMECAngseQB83DfGTowi0iMjiWaeVhAn4FJkqJByhZMI3AhiU" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="@(signedIn ? "Dashboard" : "Index")">
                <span class="brand-mark" aria-hidden="true">B</span>
                <span class="brand-name">BugTracker</span>
            </a>

            @if (signedIn)
            {
                <nav aria-label="Primary">
                    <div class="side-label">Workspace</div>
                    <a class="side-link @Nav("Home", "Dashboard")" asp-area="" asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-grid"></i><span>Dashboard</span>
                    </a>
                    <a class="side-link @Nav("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i><span>Home</span>
                    </a>
                    <a class="side-link @Nav("Companies")" asp-area="" asp-controller="Companies" asp-action="Index">
                        <i class="bi bi-building"></i><span>Company</span>
                    </a>

                    <div class="side-label">Projects</div>
                    @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
                    {
                        <a class="side-link @Nav("Projects", "Create")" asp-area="" asp-controller="Projects" asp-action="Create">
                            <i class="bi bi-plus-square"></i><span>New project</span>
                        </a>
                    }
                    @if (!User.IsInRole(nameof(Roles.Admin)))
                    {
                        <a class="side-link @Nav("Projects", "MyProjects")" asp-area="" asp-controller="Projects" asp-action="MyProjects">
                            <i class="bi bi-person"></i><span>My projects</span>
                        </a>
                    }
                    <a class="side-link @Nav("Projects", "AllProjects", "Details", "Edit", "AssignMembers", "AssignPm")" asp-area="" asp-controller="Projects" asp-action="AllProjects">
                        <i class="bi bi-folder"></i><span>All projects</span>
                    </a>
                    <a class="side-link @Nav("Projects", "ArchivedProjects", "Archive", "Restore")" asp-area="" asp-controller="Projects" asp-action="ArchivedProjects">
                        <i class="bi bi-archive"></i><span>Archived</span>
                    </a>
                    @if (User.IsInRole(nameof(Roles.Admin)))
                    {
                        <a class="side-link @Nav("Projects", "UnassignedProjects")" asp-area="" asp-controller="Projects" asp-action="UnassignedProjects">
                            <i class="bi bi-folder-x"></i><span>Unassigned</span>
                        </a>
                    }

                    <div class="side-label">Tickets</div>
                    <a class="side-link @Nav("Tickets", "Create")" asp-area="" asp-controller="Tickets" asp-action="Create">
                        <i class="bi bi-plus-square"></i><span>New ticket</span>
                    </a>
                    @if (!User.IsInRole(nameof(Roles.Admin)))
                    {
                        <a class="side-link @Nav("Tickets", "MyTickets")" asp-area="" asp-controller="Tickets" asp-action="MyTickets">
                            <i class="bi bi-person"></i><span>My tickets</span>
                        </a>
                    }
                    <a class="side-link @Nav("Tickets", "AllTickets", "Details", "Edit")" asp-area="" asp-controller="Tickets" asp-action="AllTickets">
                        <i class="bi bi-bug"></i><span>All tickets</span>
                    </a>
                    <a class="side-link @Nav("Tickets", "ArchivedTickets")" asp-area="" asp-controller="Tickets" asp-action="ArchivedTickets">
                        <i class="bi bi-archive"></i><span>Archived</span>
                    </a>
                    @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
                    {
                        <a class="side-link @Nav("Tickets", "UnassignedTickets", "AssignDeveloper")" asp-area="" asp-controller="Tickets" asp-action="UnassignedTickets">
                            <i class="bi bi-inbox"></i><span>Unassigned</span>
                        </a>
                    }

                    <div class="side-label">Inbox</div>
                    <a class="side-link @Nav("Notifications")" asp-area="" asp-controller="Notifications" asp-action="Index">
                        <i class="bi bi-bell"></i><span>Notifications</span>
                    </a>
                </nav>
            }
            else
            {
                <nav aria-label="Primary">
                    <a class="side-link @Nav("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i><span>Home</span>
                    </a>
                </nav>
            }

            <div class="sidebar-user">
                <partial name="_LoginPartial" />
            </div>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-backdrop></div>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="nav-toggle" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="false" aria-label="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-kicker">@(ViewData["Title"] ?? "BugTracker")</span>
            </header>
            <main class="app-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                &copy; @DateTime.Now.Year TheBugTracker
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-/bQdsTh/da6pkI1MST/rWKFNjaCP5gBSY4sEBT38Q/9RBh9AH40zEOg7Hlq2THRZ" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
