@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="prose-card">
    <p class="eyebrow">Something went wrong</p>
    <h1>That request did not finish.</h1>
    <p>The page could not be loaded. Try the action again, or return home.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <p class="mb-0">In Development, the exception page shows the detail. Leave Development off for anything shared.</p>
    <a class="back-link" asp-controller="Home" asp-action="Index">Back home</a>
</div>
